# Base URL of the API. "/api/v1" works out of the box in development because Vite proxies /api
# to the backend (see vite.config.js) and in production behind a same-site rewrite/custom domain.
VITE_API_URL=/api/v1

# Where the Vite dev server forwards /api requests (development only).
VITE_DEV_API_TARGET=http://localhost:5000
