# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/projectforge locally)
MONGODB_URI=mongodb://127.0.0.1:27017/projectforge

# Exact origin of the React app (no trailing slash). Used for CORS and the CSRF origin check.
CLIENT_ORIGIN=http://localhost:5173

# ── Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_COST=12

# Optional: set to your parent domain in production (e.g. .example.com) when the
# client and API live on sibling subdomains.
COOKIE_DOMAIN=

# Number of reverse proxies in front of the app (Render/Railway = 1, local = 0)
TRUST_PROXY=0

# ── Seeding (only read by `npm run seed:admin`) ──────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
